# --- Base de dados (PostgreSQL) ---
# Alinhado ao docker-compose.yml deste repo (serviço postgres):
DB_HOST=localhost
# Em Windows, se tiveres ECONNREFUSED com localhost, experimenta 127.0.0.1 (IPv4).
DB_PORT=5432
# Se nada escutar na 5432 (netstat vazio) mas tiveres Postgres outra porta (ex. 5433), usa essa porta aqui.
DB_DATABASE=projeto_pi
DB_USER=postgres
DB_PASSWORD=postgre123

# NÃO uses o utilizador "admin" do PgAdmin aqui — isso é só login na UI do PgAdmin (porta 8080).
#
# Se tiveres 28P01 com estes valores, vê README → "Se /health der 28P01".
#
# Esquema / dados de demo:
#   npm run db:setup     — esquema (init + patches).
#   npm run db:populate  — dados de demo (populate.sql); falha se já existirem as mesmas PKs (apaga base ou usa docker compose down -v).
#   Se GET /explore der 500 (relação prestador_categorias inexistente), corre db:setup com a API parada.
#   populate.sql insere joao@email.com e pedro.encanador@email.com com senha "senha123" (bcrypt).
#   Se já importaste populate antigo, corre src/infra/database/fix-demo-passwords.sql no Postgres
#   ou apaga dados e volta a importar populate.sql (ou docker compose down -v).

# --- API ---
PORT=3002
JWT_SECRET=altere_para_um_segredo_longo_em_producao

# --- Asaas (pagamentos; sandbox por defeito no código) ---
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=

# --- Métricas HTTP internas ---
# Se definido, GET /internal/metrics e /internal/metrics/stream exigem header X-Metrics-Secret com o mesmo valor.
METRICS_SECRET=

# --- Logs HTTP (middleware logFullCycle) ---
# Desligar corpo da requisição nos logs: LOG_REQUEST_BODY=0
LOG_REQUEST_BODY=
# Desligar cores no log legível: LOG_COLORS=0
LOG_COLORS=

# --- Logs de base de dados (pool.query instrumentado) ---
# Se > 0, regista consultas lentas (ms) em nível info (db.query.slow)
LOG_SLOW_QUERY_MS=0
# NOTICE do Postgres em JSON (db.client.notice): LOG_DB_NOTICE=1
LOG_DB_NOTICE=
# Eventos debug no logger: LOG_DEBUG=1
LOG_DEBUG=
