# Base de dados, JWT, etc. (ajuste ao seu ambiente)
# DATABASE_URL=...

# E-mail (Nodemailer) — em desenvolvimento, sem estas variáveis o servidor apenas regista o e-mail no consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Opcional: remetente visível (predefinido: mesmo que SMTP_USER)
# MAIL_FROM="DOMI <noreply@seudominio.com>"

# Asaas (pagamentos PIX) — sandbox por defeito no código se ASAAS_BASE_URL estiver vazio
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
